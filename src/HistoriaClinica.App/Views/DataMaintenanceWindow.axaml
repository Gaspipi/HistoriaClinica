<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HistoriaClinica.App.ViewModels"
        xmlns:services="using:HistoriaClinica.Core.Services"
        x:Class="HistoriaClinica.App.Views.DataMaintenanceWindow"
        x:DataType="vm:DataMaintenanceViewModel"
        Title="Mantenimiento de datos"
        Width="640" Height="480">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="Respaldos" FontWeight="Bold" />
    <TextBlock Text="Seleccione un respaldo para restaurar. Esta acción reemplaza la base de datos actual." />
    <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding BackupSeleccionado}" Height="260">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="services:BackupInfo">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding FileName}" />
            <TextBlock Text="{Binding CreatedUtc}" />
            <TextBlock Text="{Binding SizeBytes}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Cargar" Command="{Binding CargarBackupsCommand}" />
      <Button Content="Restaurar" Command="{Binding RestaurarBackupCommand}" CommandParameter="{Binding BackupSeleccionado}" />
      <Button Content="Cerrar" Command="{Binding CerrarCommand}" />
    </StackPanel>
    <TextBlock Text="{Binding MensajeError}" Foreground="Red" />
    <TextBlock Text="{Binding MensajeEstado}" />
  </StackPanel>
</Window>
