<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HistoriaClinica.App.ViewModels"
        xmlns:icons="using:HistoriaClinica.App.Icons"
        xmlns:automation="using:Avalonia.Automation"
        x:Class="HistoriaClinica.App.Views.PreferencesWindow"
        x:DataType="vm:PreferencesViewModel"
        Title="Preferencias"
        Width="500"
        Height="560"
        MinWidth="340"
        MinHeight="360"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Grid#PageRoot">
      <Setter Property="Margin" Value="20" />
    </Style>
    <Style Selector="Window.narrow Grid#PageRoot">
      <Setter Property="Margin" Value="14" />
    </Style>
  </Window.Styles>

  <Grid x:Name="PageRoot" RowDefinitions="*,Auto" RowSpacing="12">
    <Border Classes="card" Padding="20">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Classes="icon"
                    VerticalAlignment="Center"
                    Data="{x:Static icons:LucideIcons.Settings}" />
              <TextBlock Text="Preferencias" Classes="h2" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="Personalizá la apariencia de la aplicación."
                       Classes="subtitle" />
          </StackPanel>

          <StackPanel>
            <TextBlock Text="Tema" Classes="fieldLabel" />
            <ComboBox ItemsSource="{Binding Temas}"
                      SelectedIndex="{Binding TemaSeleccionado, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      automation:AutomationProperties.Name="Tema de la aplicación" />
          </StackPanel>

          <StackPanel>
            <TextBlock Text="Tamaño de texto" Classes="fieldLabel" />
            <ComboBox ItemsSource="{Binding TamanosTexto}"
                      SelectedIndex="{Binding TamanoTextoSeleccionado, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      automation:AutomationProperties.Name="Tamaño de texto de la aplicación" />
            <TextBlock Text="Ajusta el tamaño del texto y de los controles. El cambio se aplica al guardar y se recuerda para la próxima apertura."
                       Classes="caption"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
          </StackPanel>

          <Border Classes="errorBanner" IsVisible="{Binding HayError}">
            <TextBlock Text="{Binding MensajeError}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}" />
          </Border>

          <Button Classes="secondary"
                  Command="{Binding RestablecerCommand}"
                  HorizontalAlignment="Left"
                  automation:AutomationProperties.Name="Restablecer preferencias">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon onSecondary" Data="{x:Static icons:LucideIcons.RotateCcw}" />
              <TextBlock Text="Restablecer" />
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Right">
      <Button Classes="secondary"
              Command="{Binding CancelarCommand}"
              IsCancel="True"
              MinWidth="100"
              automation:AutomationProperties.Name="Cancelar">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="icon onSecondary" Data="{x:Static icons:LucideIcons.X}" />
          <TextBlock Text="Cancelar" />
        </StackPanel>
      </Button>
      <Button Classes="primary"
              Command="{Binding GuardarCommand}"
              IsDefault="True"
              MinWidth="100"
              automation:AutomationProperties.Name="Guardar preferencias">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="icon onAccent" Data="{x:Static icons:LucideIcons.Check}" />
          <TextBlock Text="Guardar" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</Window>
