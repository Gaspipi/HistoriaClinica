<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:HistoriaClinica.App.Icons"
        x:Class="HistoriaClinica.App.Views.MessageDialog"
        Width="480"
        MinWidth="280"
        MinHeight="220"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Window.narrow StackPanel#DialogActions">
      <Setter Property="Orientation" Value="Vertical" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Window.narrow StackPanel#DialogActions > Button">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>

  <Border Classes="card" Margin="20">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
      <TextBlock x:Name="TitleText"
                 Classes="h2"
                 TextWrapping="Wrap" />
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="MessageText"
                   Classes="subtitle"
                   TextWrapping="Wrap" />
      </ScrollViewer>
      <StackPanel x:Name="DialogActions"
                  Grid.Row="2"
                  Orientation="Horizontal"
                  Spacing="8"
                  HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Classes="secondary" MinWidth="90">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="icon onSecondary" Data="{x:Static icons:LucideIcons.X}" />
            <TextBlock x:Name="CancelText" Text="Cancelar" />
          </StackPanel>
        </Button>
        <Button x:Name="AcceptButton" Classes="primary" IsDefault="True" MinWidth="90">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="icon onAccent" Data="{x:Static icons:LucideIcons.Check}" />
            <TextBlock x:Name="AcceptText" Text="Aceptar" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>
